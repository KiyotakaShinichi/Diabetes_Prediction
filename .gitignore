__pycache__/
catboost_info/
.venv/
.venv*/
*.pyc
inference_log.db
_test_*.py
data/

# Admin credential store. The runtime location is data/admin_users.json (data/
# is already ignored above); /admin_users.json is the pre-Track-E location and
# is ignored so a stale local copy cannot be re-committed.
/admin_users.json

# Local environment files (never commit real secrets). .env.example is tracked.
.env
.env.*
!.env.example

# Streamlit secrets (never commit real secrets)
.streamlit/secrets.toml

# Allow model artifacts in git (small enough for demo)
# *.pkl

# Test / lint caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Archived experiment outputs (see experiment_config.DEFAULT_RESULTS_DIR)
experiment_results/

# Track K research outputs. Runs are reproducible from the committed protocol
# rather than from committed weights, and these must never be confused with the
# governed artifacts in model_artifacts/.
research_artifacts/
