{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  // Canonical runtime family: Python 3.11, matching CI and the Dockerfile.
  // The devcontainers image is published per minor version only, so the exact
  // canonical patch (3.11.16) cannot be pinned through this tag. The image
  // tracks the latest 3.11 patch, which satisfies the artifact contract; CI and
  // the Dockerfile remain the authority on the exact tested version.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.lock -r requirements-dev.lock && echo 'Locked dependencies installed (scikit-learn 1.8.0 / xgboost 3.0.4)'",
  "postAttachCommand": {
    "server": "streamlit run streamlit_app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}